{
  "name": "dalel",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "check-tasks": "vitest run tests/tasks.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node e2e/demo.cjs",
    "build:page": "VITE_NO_SW=1 vite build --outDir dist-page && node scripts/build-page.mjs dist-page dalel-page.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
