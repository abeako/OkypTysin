# Пример переменных окружения. Скопируйте файл в .env и впишите свои значения.
# Настоящие ключи в репозиторий не коммитьте: .env указан в .gitignore.

# Ключ Claude API — только на сервере (/api/hint). Без него работают офлайн-подсказки.
ANTHROPIC_API_KEY=

# Модель для подсказок (необязательно). По умолчанию: claude-opus-5-5
# HINT_MODEL=claude-opus-5-5
